PORT=3000
BRIDGE_TOKEN=change-this-long-random-token

# رقم واتساب بصيغة دولية أرقام فقط، مثال السعودية: 9665XXXXXXXX
WA_PHONE_NUMBER=
WA_AUTH_DIR=/data/auth
ALLOW_GROUPS=false

# اختر أحد المسارين:
# 1) n8n: أرسل الرسالة إلى Webhook ويرجع JSON يحتوي reply
N8N_INBOUND_URL=

# 2) أو Meta Muse مباشرة (بدون n8n)
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.2
MODEL_REASONING_EFFORT=high

LOG_LEVEL=info
